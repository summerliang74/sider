# Public application origin. Production must use HTTPS.
APP_BASE_URL=http://localhost:3000
# Generate independent random values of at least 32 characters.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TOKEN_PEPPER=replace-with-another-32-random-characters
SESSION_TTL_SECONDS=3600

# TLS is required outside local development.
DATABASE_URL=postgresql://shsid:change-me@localhost:5432/shsid_online?sslmode=disable
# Neon direct connection used by Drizzle migrations. Falls back to DATABASE_URL when absent.
DATABASE_URL_UNPOOLED=postgresql://shsid:change-me@localhost:5432/shsid_online?sslmode=disable
DATABASE_MAX_CONNECTIONS=5

# Exact Launchpad sub values for initial administrators.
SHSID_ADMIN_SUBS=replace-with-confirmed-admin-sub
# Set one exact verified Launchpad email only while discovering an administrator sub, then restore "disabled".
SHSID_LAUNCHPAD_ORG_DISCOVERY_EMAIL=disabled
SHSID_LAUNCHPAD_OIDC_DEV=1

# Private Alibaba Cloud OSS bucket (Beijing, Standard LRS). The application
# also accepts AWS_* variables as a fallback for other S3-compatible providers.
S3_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
S3_REGION=cn-beijing
S3_BUCKET=sider-prod-upload
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=false
UPLOAD_MAX_BYTES=52428800
RATE_LIMIT_URL=https://replace.example
RATE_LIMIT_TOKEN=replace-me
RATE_LIMIT_MULTIPLIER=1
# Replace with values validated under the school's shared-egress login load test.
OAUTH_START_IP_LIMIT=300
OAUTH_CALLBACK_IP_LIMIT=600
TRUSTED_CLIENT_IP_HEADER=x-real-ip
NEXT_PUBLIC_BOT_SITE_KEY=replace-me
BOT_VERIFY_URL=https://replace.example
BOT_VERIFY_SECRET=replace-me
# Use "disabled" for both values during login/domain bring-up. Uploads fail
# closed until a real scanner endpoint and token replace them.
MALWARE_SCAN_URL=disabled
MALWARE_SCAN_TOKEN=disabled
MALWARE_SCAN_TIMEOUT_MS=30000
SCANNER_HOST=127.0.0.1
SCANNER_PORT=8081
SCANNER_MAX_BYTES=52428800
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
CLAMD_TIMEOUT_MS=25000
CRON_SECRET=replace-with-a-third-32-character-random-value
RESOURCE_DELETE_RETENTION_DAYS=7
# Separate supervised upload worker; use http://app:3000 inside Compose.
UPLOAD_WORKER_BASE_URL=http://127.0.0.1:3000
