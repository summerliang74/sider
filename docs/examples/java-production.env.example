# Java application template: not consumed by the legacy Next.js application.
# Configure Launchpad runtime Variables/Secrets by reference, never image build values.
# This file is a checklist; Spring does not auto-load it.
# Every placeholder MUST be replaced; do not commit the populated file.
SPRING_PROFILES_ACTIVE=production
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8080
# Provisional only: verify the actual Launchpad process-memory budget before use.
JAVA_TOOL_OPTIONS="-Xms128m -Xmx512m"
APP_BASE_URL=https://app.example.invalid

# Custom settings are explicitly bound and validated by the Java application.
SESSION_TRANSPORT=cookie
SESSION_TOKEN_PEPPER=replace-with-independent-random-secret-at-least-32-bytes
SESSION_TTL_SECONDS=3600
CURSOR_SIGNING_KEY=replace-with-independent-random-secret-at-least-32-bytes

# Runtime identity only. Do not inject DATABASE_URL_UNPOOLED/DDL credentials here.
DATABASE_URL=postgresql://app_user:replace-me@db.example.invalid/sider?sslmode=verify-full
DATABASE_MAX_CONNECTIONS=5
SHSID_ADMIN_SUBS=replace-with-confirmed-launchpad-sub
SHSID_LAUNCHPAD_OIDC_DEV=0

S3_ENDPOINT=https://storage.example.invalid
S3_REGION=replace-region
S3_BUCKET=replace-private-bucket
S3_ACCESS_KEY_ID=replace-with-app-scoped-access-key
S3_SECRET_ACCESS_KEY=replace-with-app-scoped-secret
S3_FORCE_PATH_STYLE=false
UPLOAD_MAX_BYTES=52428800
# Keep the legacy streamed-upload compatibility route disabled (HTTP 410).
LEGACY_UPLOAD_ENABLED=false

RATE_LIMIT_URL=https://limiter.example.invalid
RATE_LIMIT_TOKEN=replace-with-environment-scoped-token
RATE_LIMIT_MULTIPLIER=1
OAUTH_START_IP_LIMIT=300
# Legacy config name retained; does not add a second Java callback state machine.
OAUTH_CALLBACK_IP_LIMIT=600
TRUSTED_CLIENT_IP_HEADER=x-real-ip

# Public site key only; returned at runtime through GET /api/config.
BOT_SITE_KEY=replace-public-site-key
BOT_VERIFY_URL=https://verifier.example.invalid/verify
BOT_VERIFY_SECRET=replace-with-private-verification-secret

# Uploads require a verified TLS scanner. Paired disabled is for login bring-up only.
MALWARE_SCAN_URL=https://scanner.example.invalid/scan
MALWARE_SCAN_TOKEN=replace-with-independent-scanner-auth-token
MALWARE_SCAN_TIMEOUT_MS=30000
CRON_SECRET=replace-with-independent-random-cron-secret-at-least-32-bytes
RESOURCE_DELETE_RETENTION_DAYS=7
UPLOAD_WORKER_ENABLED=true
