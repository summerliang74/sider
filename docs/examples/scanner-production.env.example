# Separate scanner service DESIGN template, not Java application settings.
# Inject independently. Never reuse the application's S3 write identity.
# These values use the CURRENT scanner names; replace every placeholder.
MALWARE_SCAN_TOKEN=replace-with-same-scanner-auth-token-as-application
S3_ENDPOINT=https://storage.example.invalid
S3_REGION=replace-region
S3_BUCKET=replace-private-bucket
S3_ACCESS_KEY_ID=replace-with-read-only-scanner-access-key
S3_SECRET_ACCESS_KEY=replace-with-read-only-scanner-secret
S3_FORCE_PATH_STYLE=false
SCANNER_MAX_BYTES=52428800
CLAMD_TIMEOUT_MS=25000

# Compose-specific names: 0.0.0.0 listens INSIDE container, host mapping stays loopback.
# The current Compose file fixes SCANNER_HOST/PORT and CLAMD_HOST/PORT itself.
# Outside Compose, explicitly set these process environment values:
# SCANNER_HOST=127.0.0.1
# SCANNER_PORT=8081
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310
# Keep ClamAV signatures in a persistent private volume; do not expose 3310.
# Do not add SESSION_*, DATABASE_*, CRON_SECRET or the administrator allowlist here.
