NODE_ENV=production
APP_BASE_URL=https://your-domain.example

SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TOKEN_PEPPER=replace-with-another-32-random-characters
SESSION_TTL_SECONDS=3600

DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require
DATABASE_MAX_CONNECTIONS=5

# Exact Launchpad subject values for administrators.
SHSID_ADMIN_SUBS=replace-with-confirmed-admin-sub
SHSID_LAUNCHPAD_ORG_DISCOVERY_EMAIL=disabled
SHSID_LAUNCHPAD_OIDC_DEV=0

S3_ENDPOINT=https://your-s3-endpoint.example
S3_REGION=your-region
S3_BUCKET=your-private-bucket
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=false
UPLOAD_MAX_BYTES=52428800

RATE_LIMIT_URL=https://your-redis-rest-endpoint.example
RATE_LIMIT_TOKEN=replace-with-at-least-16-characters
RATE_LIMIT_MULTIPLIER=1
OAUTH_START_IP_LIMIT=20
OAUTH_CALLBACK_IP_LIMIT=20
TRUSTED_CLIENT_IP_HEADER=x-real-ip

NEXT_PUBLIC_BOT_SITE_KEY=replace-me
BOT_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
BOT_VERIFY_SECRET=replace-with-at-least-16-characters

MALWARE_SCAN_URL=disabled
MALWARE_SCAN_TOKEN=disabled
MALWARE_SCAN_TIMEOUT_MS=30000
CRON_SECRET=replace-with-a-third-32-character-random-value
RESOURCE_DELETE_RETENTION_DAYS=7
