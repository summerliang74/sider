{
  "name": "sider-tooling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Java application support: native frontend tests, database migrations and service checks",
  "engines": {
    "node": ">=20.9 <25"
  },
  "scripts": {
    "build": "mvn -B -ntp -f backend/pom.xml package",
    "start": "java -jar backend/target/sider-1.0.0.jar",
    "test": "node --test scripts/vanilla-*.test.mjs scripts/navigation-cache.test.mjs",
    "test:java": "mvn -B -ntp -f backend/pom.xml verify",
    "lint": "eslint backend/src/main/resources/static scripts db drizzle.config.js eslint.config.mjs --max-warnings=0",
    "verify:production": "node scripts/verify-production.mjs",
    "verify:services": "node --env-file=.env.local scripts/verify-services.mjs",
    "scanner:start": "node --env-file=.env.local services/malware-scanner/server.mjs",
    "scanner:test": "node --test services/malware-scanner/server.test.mjs",
    "db:generate": "drizzle-kit generate --config=drizzle.config.js",
    "db:migrate": "node scripts/migrate.mjs",
    "db:check": "drizzle-kit check --config=drizzle.config.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.7",
    "eslint": "9.39.4"
  }
}
